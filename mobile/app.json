{
  "expo": {
    "name": "KyroPad",
    "slug": "kyropad",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0d0d0d",
    "primaryColor": "#00e5ff",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "dark",
      "backgroundColor": "#0d0d0d",
      "bundleIdentifier": "com.makinity.kyropad"
    },
    "android": {
      "package": "com.makinity.kyropad",
      "userInterfaceStyle": "dark",
      "backgroundColor": "#0d0d0d",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0d0d"
      }
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "themeColor": "#0d0d0d",
      "backgroundColor": "#0d0d0d"
    },
    "extra": {
      "eas": {
        "projectId": "e0ef4a70-f5c0-4fe9-ba9d-4eb4e1a8ff73"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0d0d0d",
          "dark": {
            "image": "./assets/splash.png",
            "resizeMode": "contain",
            "backgroundColor": "#0d0d0d"
          }
        }
      ]
    ]
  }
}
